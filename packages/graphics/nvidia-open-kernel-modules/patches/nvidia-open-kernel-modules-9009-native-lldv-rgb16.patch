+NvBool nvIsNativeLldvColor(const struct NvKmsHdmiVsifMetadata *vsif,
+                           const NVDpyAttributeColor *color)
+{
+    return nvDoviLowLatency(vsif->payload, vsif->payloadSize) &&
+        color->format == NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_YCbCr422 &&
+        color->bpc == NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_12 &&
+        color->range == NV_KMS_DPY_ATTRIBUTE_COLOR_RANGE_LIMITED &&
+        color->colorimetry == NVKMS_OUTPUT_COLORIMETRY_BT2100;
+}
+
+NvBool nvIsNativeLldvSurface(const NVFlipEvoHwState *flip)
+{
+    const NVSurfaceEvoRec *surface = flip->layer[NVKMS_MAIN_LAYER].pSurfaceEvo[NVKMS_LEFT];
+    return surface && surface->format == NvKmsSurfaceMemoryFormatR16G16B16A16 &&
+        nvDoviLowLatency(flip->hdmiVsifMetadata.payload, flip->hdmiVsifMetadata.payloadSize);
+}
