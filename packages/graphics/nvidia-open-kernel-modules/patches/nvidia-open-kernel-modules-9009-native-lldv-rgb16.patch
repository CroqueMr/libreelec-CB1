@@ -1188,9 +1207,12 @@ nv_drm_connector_new(struct drm_device *dev,
         drm_connector_attach_hdr_output_metadata_property(&nv_connector->base);
 
         if (nv_connector->type == NVKMS_CONNECTOR_TYPE_HDMI &&
