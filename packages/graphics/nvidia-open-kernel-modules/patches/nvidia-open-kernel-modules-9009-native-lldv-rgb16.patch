@@ -775,6 +786,7 @@ static bool nv_drm_lldv_supported(struct drm_connector *connector,
 {
     const struct nv_drm_connector *nv_connector = to_nv_connector(connector);
     const struct drm_edid *edid = nv_connector->edid;
+    const bool native = to_nv_drm_connector_state_const(conn)->lldv_format == 3;
