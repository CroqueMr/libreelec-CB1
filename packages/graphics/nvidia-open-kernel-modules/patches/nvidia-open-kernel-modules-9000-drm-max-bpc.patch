Subject: [PATCH] nvidia-drm: preserve the CB1 HDMI max bpc control on R620

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index e539193..62cc9ac 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -47,6 +47,8 @@
 #include <drm/drm_edid.h>
 #include <drm/drm_sysfs.h>
 
+#define NV_DRM_MAX_BPC_DEFAULT 12
+
 static void nv_drm_connector_set_allm_capable(struct nv_drm_connector *nv_connector,
                                               NvBool allmCapable);
 
@@ -348,6 +350,11 @@ nv_drm_connector_atomic_create_state(struct drm_connector *connector)
     __drm_atomic_helper_connector_state_reset(&nv_connector_state->base, connector);
 #endif
 
+    if (connector->max_bpc_property) {
+        nv_connector_state->base.max_requested_bpc = NV_DRM_MAX_BPC_DEFAULT;
+        nv_connector_state->base.max_bpc = NV_DRM_MAX_BPC_DEFAULT;
+    }
+
     return &nv_connector_state->base;
 }
 #else
@@ -366,6 +373,10 @@ static void nv_drm_connector_reset(struct drm_connector *connector)
     }
 
     __drm_atomic_helper_connector_reset(connector, &nv_connector_state->base);
+    if (connector->max_bpc_property) {
+        nv_connector_state->base.max_requested_bpc = NV_DRM_MAX_BPC_DEFAULT;
+        nv_connector_state->base.max_bpc = NV_DRM_MAX_BPC_DEFAULT;
+    }
 }
 #endif
 
@@ -736,15 +747,29 @@ __nv_drm_connector_atomic_check(struct drm_connector *connector,
     }
     req_config->modeSetConfig.colorFormat = nvkms_fmt;
 
-    /* Handle output bpc changes */
-    req_config->flags.colorBpcChanged =
-        (nv_old_connector_state->output_bpc !=
-         nv_new_connector_state->output_bpc);
+    /* Resolve the standard HDMI limit and the vendor request together. */
     ret = nv_drm_connector_translate_output_bpc(
         nv_new_connector_state->output_bpc, &nvkms_bpc);
     if (ret != 0) {
         return ret;
     }
+    if (connector->max_bpc_property) {
+        const u8 max_bpc = new_connector_state->max_requested_bpc;
+
+        if (nvkms_bpc > max_bpc) {
+            return -EINVAL;
+        }
+        /*
+         * Preserve the CB1 HDMI contract: an 8/9 bpc limit with AUTO
+         * requests 8 bpc; higher AUTO values let NVKMS choose the depth.
+         */
+        if (nvkms_bpc == NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_UNKNOWN &&
+            max_bpc < 10) {
+            nvkms_bpc = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_8;
+        }
+    }
+    req_config->flags.colorBpcChanged |=
+        req_config->modeSetConfig.colorBpc != nvkms_bpc;
     req_config->modeSetConfig.colorBpc = nvkms_bpc;
 
     /* Handle HDMI VSIF metadata changes */
@@ -1006,6 +1031,11 @@ nv_drm_connector_new(struct drm_device *dev,
 
     /* Attach color format and output bpc properties for HDMI connectors */
     if (nv_connector->type == NVKMS_CONNECTOR_TYPE_HDMI) {
+        ret = drm_connector_attach_max_bpc_property(&nv_connector->base, 8,
+                                                   NV_DRM_MAX_BPC_DEFAULT);
+        if (ret != 0) {
+            goto failed_connector_register;
+        }
         if (nv_dev->nv_connector_color_format_property) {
             drm_object_attach_property(
                 &nv_connector->base.base,
