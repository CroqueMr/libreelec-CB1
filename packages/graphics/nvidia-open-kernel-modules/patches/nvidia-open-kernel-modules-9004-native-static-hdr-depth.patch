Subject: [PATCH] Validate requested static HDR EOTF and expose accepted output depth

diff --git a/kernel-open/common/inc/nvkms-kapi.h b/kernel-open/common/inc/nvkms-kapi.h
index 736e035..d28114b 100644
--- a/kernel-open/common/inc/nvkms-kapi.h
+++ b/kernel-open/common/inc/nvkms-kapi.h
@@ -1697,6 +1697,9 @@ struct NvKmsKapiFunctionsTable {
         struct NvKmsKapiDevice *device,
         const NvU32 head,
         struct NvKmsKapiVblankIntrCallback *pCallback);
+    /* Kernel-client-only diagnostic; appended to preserve preceding offsets. */
+    NvU32 (*getCurrentOutputBpc)(struct NvKmsKapiDevice *device,
+                                NvKmsKapiDisplay display, NvU32 head);
 };
 
 /** @} */
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
