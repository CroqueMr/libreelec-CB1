diff --git a/src/nvidia-modeset/kapi/src/nvkms-kapi.c b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
index 242b3e6..65c6b05 100644
--- a/src/nvidia-modeset/kapi/src/nvkms-kapi.c
+++ b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
@@ -2545,6 +2545,44 @@ static void InitNvKmsModeValidationParams(
     params->overrides = NVKMS_MODE_VALIDATION_NO_RRX1K_CHECK;
 }
 
+/* Query accepted native output, never the requested framebuffer/max precision. */
+static NvU32 GetCurrentOutputBpc(struct NvKmsKapiDevice *device,
+                                 NvKmsKapiDisplay display, NvU32 head)
+{
+    struct NvKmsGetDpyAttributeParams params = { };
+
+    if (device == NULL) {
+        return 0;
+    }
+    params.request.deviceHandle = device->hKmsDevice;
+    params.request.dispHandle = device->hKmsDisp;
+    params.request.dpyId = nvNvU32ToDpyId(display);
+    params.request.attribute = NV_KMS_DPY_ATTRIBUTE_HEAD;
+    if (!nvkms_ioctl_from_kapi(device->pKmsOpen,
+            NVKMS_IOCTL_GET_DPY_ATTRIBUTE, &params, sizeof(params)) ||
+        params.reply.value != head) {
+        return 0;
+    }
+    params.request.attribute = NV_KMS_DPY_ATTRIBUTE_DPMS;
+    if (!nvkms_ioctl_from_kapi(device->pKmsOpen,
+            NVKMS_IOCTL_GET_DPY_ATTRIBUTE, &params, sizeof(params)) ||
+        params.reply.value != NV_KMS_DPY_ATTRIBUTE_DPMS_ON) {
+        return 0;
+    }
+    params.request.attribute = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC;
+    if (!nvkms_ioctl_from_kapi(device->pKmsOpen,
+            NVKMS_IOCTL_GET_DPY_ATTRIBUTE, &params, sizeof(params))) {
+        return 0;
+    }
+    if (params.reply.value == 6 || params.reply.value == 8 ||
+        params.reply.value == 10 ||
+        (params.reply.value == 12 &&
+         NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_MAX >= 12)) {
+        return (NvU32)params.reply.value;
+    }
+    return 0;
+}
+
 static int GetDisplayMode
 (
     struct NvKmsKapiDevice *device,
@@ -4234,6 +4272,7 @@ NvBool nvKmsKapiGetFunctionsTableInternal
     funcsTable->destroySurface = DestroySurface;
 
     funcsTable->getDisplayMode      = GetDisplayMode;
+    funcsTable->getCurrentOutputBpc = GetCurrentOutputBpc;
     funcsTable->validateDisplayMode = ValidateDisplayMode;
 
     funcsTable->applyModeSetConfig   = ApplyModeSetConfig;
diff --git a/src/nvidia-modeset/src/nvkms-dpy.c b/src/nvidia-modeset/src/nvkms-dpy.c
index 4e25710..4f2c33c 100644
--- a/src/nvidia-modeset/src/nvkms-dpy.c
+++ b/src/nvidia-modeset/src/nvkms-dpy.c
@@ -3884,7 +3884,6 @@ NvU32 nvDpyGetPossibleApiHeadsMask(const NVDpyEvoRec *pDpyEvo)
 
 NvBool nvDpyIsHDRCapable(const NVDpyEvoRec *pDpyEvo)
 {
-    const NVDevEvoRec *pDevEvo = pDpyEvo->pDispEvo->pDevEvo;
     const NVT_EDID_INFO *pInfo = &pDpyEvo->parsedEdid.info;
     const NVT_HDR_STATIC_METADATA *pHdrInfo =
         &pInfo->hdr_static_metadata_info;
@@ -3915,21 +3914,12 @@ NvBool nvDpyIsHDRCapable(const NVDpyEvoRec *pDpyEvo)
         return FALSE;
     }
 
-    /*
-     * When the HAL does not support generic shared infoframes (e.g. on EVO1),
-     * HDR and HDMI3D both share the VSIF slot. Skip HDR if HDMI 3D is supported.
-     */
-    if (!pDevEvo->caps.supportsGenericSharedInfoFrames &&
-        pInfo->HDMI3DSupported) {
+    /* Capability is independent of the currently selected packet owner. */
+    if (!pHdrInfo->supported_eotf.smpte_st_2084_eotf &&
+        !pHdrInfo->supported_eotf.hybrid_log_gamma_eotf) {
         return FALSE;
     }
 
-    // Sink should support ST2084 EOTF or HLG
-    if (!(pHdrInfo->supported_eotf.smpte_st_2084_eotf ||
-          pHdrInfo->supported_eotf.hybrid_log_gamma_eotf)) {
-      return FALSE;
-    }
-
     /*
      * Sink should support static metadata type1. Nvtiming sets
      * static_metadata_type to 1 if the sink supports static metadata type1.
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index da2e872..1f24b6d 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -773,6 +773,7 @@ SendHDRInfoFrame(const NVDpyEvoRec *pDpyEvo, const NvU32 head,
     const NVDispHeadStateEvoRec *pHeadState =
                                  &pDispEvo->headState[head];
     const NVT_EDID_INFO *pEdidInfo = &pDpyEvo->parsedEdid.info;
+    const NVT_HDR_STATIC_METADATA *pHdrInfo = &pEdidInfo->hdr_static_metadata_info;
     NVT_HDR_INFOFRAME hdrInfoFrame = { 0 };
     NvEvoInfoFrameTransmitFrequency frequency =
         NV_EVO_INFOFRAME_TRANSMIT_FREQUENCY_INIT;
@@ -780,15 +781,34 @@ SendHDRInfoFrame(const NVDpyEvoRec *pDpyEvo, const NvU32 head,
     if (!nvDpyIsHDRCapable(pDpyEvo)) {
         return;
     }
+    if (pHeadState->hdrInfoFrame.state == NVKMS_HDR_INFOFRAME_STATE_ENABLED) {
+        NvBool supported = FALSE;
+        switch (pHeadState->hdrInfoFrame.eotf) {
+        case NVKMS_INFOFRAME_EOTF_SDR_GAMMA:
+            supported = pHdrInfo->supported_eotf.trad_gamma_sdr_eotf;
+            break;
+        case NVKMS_INFOFRAME_EOTF_HDR_GAMMA:
+            supported = pHdrInfo->supported_eotf.trad_gamma_hdr_eotf;
+            break;
+        case NVKMS_INFOFRAME_EOTF_ST2084:
+            supported = pHdrInfo->supported_eotf.smpte_st_2084_eotf;
+            break;
+        case NVKMS_INFOFRAME_EOTF_HLG:
+            supported = pHdrInfo->supported_eotf.hybrid_log_gamma_eotf;
+            break;
+        default:
+            break;
+        }
+        if (!supported) {
+            return;
+        }
+    }
 
-    /*
-     * When the HAL does not support generic shared infoframes (e.g. on EVO1),
-     * HDR and VSIF share a single vendor-specific slot. Skip sending HDR when
-     * HDMI 3D is supported or user VSIF override is enabled.
-     */
+    /* A 3D-capable receiver alone does not own the shared packet slot. */
     if (!pDevEvo->caps.supportsGenericSharedInfoFrames &&
-        (IsHdmi3DVendorSpecificInfoFrameEnabled(
-             &pInfoFrameState->vendorSpecificCtrl, pEdidInfo) ||
+        ((pInfoFrameState->vendorSpecificCtrl.Enable &&
+          (pInfoFrameState->vendorSpecificCtrl.HDMIFormat != NVT_HDMI_VS_BYTE4_HDMI_VID_FMT_3D ||
+           pEdidInfo->HDMI3DSupported)) ||
          pHeadState->hdmiVsifMetadata.payloadSize != 0)) {
         return;
     }
