     status = NvTiming_ConstructVideoInfoframe(pEdidInfo,
                                               &videoCtrl,
                                               NULL, &VideoInfoFrame);
@@ -641,6 +649,7 @@ UpdateVendorSpecificInfoFrame(
 static void
 SendUserDefinedVSIF(const NVDispEvoRec *pDispEvo,
                     const NvU32 head,
+                    const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
                     NvEvoInfoFrameTransmitControl *currentTransmitCtrl,
                     NvEvoInfoFrameTransmitControl *newTransmitCtrl)
 {
@@ -658,6 +667,11 @@ SendUserDefinedVSIF(const NVDispEvoRec *pDispEvo,
                  pHeadState->hdmiVsifMetadata.payload,
                  pHeadState->hdmiVsifMetadata.payloadSize);
 
+    nvDoviTiming((NvU8 *)&vendorInfoFrame.Data,
+                 pHeadState->hdmiVsifMetadata.payloadSize,
+                 pInfoFrameState->ctrl.video_format_id,
+                 pInfoFrameState->vendorSpecificCtrl.HDMI_VIC);
+
     UpdateVendorSpecificInfoFrame(
         pDispEvo,
         head,
@@ -691,6 +705,7 @@ SendVendorSpecificInfoFrame(const NVDispEvoRec *pDispEvo,
     if (pHeadState->hdmiVsifMetadata.payloadSize != 0) {
         SendUserDefinedVSIF(pDispEvo,
                             head,
+                            pInfoFrameState,
                             currentTransmitCtrl,
                             newTransmitCtrl);
         return;
