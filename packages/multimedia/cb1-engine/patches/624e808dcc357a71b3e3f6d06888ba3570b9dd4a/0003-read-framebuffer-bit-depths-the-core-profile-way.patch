   "src/cb1_hdr10_ai.c": "77432675f0f122e12294238987b5d66e5e99cc11653e1ddc4701ef5c6fedf129",
@@ -36,7 +36,7 @@
   "src/dvbridge_placebo.h": "1ae453d519231b702dcf128fa6a5c8347491485f746023bf5f7c8ef478ccfef4",
   "src/dvbridge_policy.c": "372986bc8bacd0cb68ca4af440a0b255e2954b1f357cfe84a3fbb9199b8b561d",
   "src/dvbridge_policy.h": "560dbfb112f687461ef9f394d867188724dbbd74135329876325fde4cc793392",
-  "src/dvbridge_render.c": "748d3b596faf297f5d831a9c8988433f2113fc5257a6f7c17be03b6cbf4bc56c",
