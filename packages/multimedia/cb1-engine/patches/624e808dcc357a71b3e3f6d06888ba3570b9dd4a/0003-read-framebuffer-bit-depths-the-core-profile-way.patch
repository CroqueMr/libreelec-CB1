 }
diff --git a/src/dvbridge_gl_api.h b/src/dvbridge_gl_api.h
index c9c3c9a..dce4a2b 100644
--- a/src/dvbridge_gl_api.h
+++ b/src/dvbridge_gl_api.h
@@ -18,3 +18,17 @@
 #define GL_CLIENT_MAPPED_BUFFER_BARRIER_BIT_EXT GL_CLIENT_MAPPED_BUFFER_BARRIER_BIT
 #endif
 typedef PFNGLBUFFERSTORAGEPROC PFNGLBUFFERSTORAGEEXTPROC;
+
+/* Core profiles dropped GL_RED_BITS and friends and call the default colour buffer
+ * GL_BACK_LEFT, so read the sizes and the encoding from the bound colour attachment. */
+static inline void dvbridge_gl_color_bits(GLuint framebuffer, GLint bits[4], GLint *encoding)
+{
+    static const GLenum sizes[4] = {GL_FRAMEBUFFER_ATTACHMENT_RED_SIZE,
+        GL_FRAMEBUFFER_ATTACHMENT_GREEN_SIZE, GL_FRAMEBUFFER_ATTACHMENT_BLUE_SIZE,
+        GL_FRAMEBUFFER_ATTACHMENT_ALPHA_SIZE};
+    const GLenum attachment = framebuffer ? GL_COLOR_ATTACHMENT0 : GL_BACK_LEFT;
+    for (int i = 0; i < 4; ++i)
+        glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, attachment, sizes[i], &bits[i]);
+    glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, attachment,
+        GL_FRAMEBUFFER_ATTACHMENT_COLOR_ENCODING, encoding);
+}
diff --git a/src/dvbridge_gl_pack.c b/src/dvbridge_gl_pack.c
index abfbbec..8e835dc 100644
--- a/src/dvbridge_gl_pack.c
+++ b/src/dvbridge_gl_pack.c
@@ -134,13 +134,21 @@ static bool pack(struct dvbridge_gl_packer *p, unsigned texture, unsigned frameb
     bool ok = false;
     glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
     GLint red, green, blue, samples, encoding;
+#if defined(DVBRIDGE_DESKTOP_GL)
+    GLint bits[4];
+    dvbridge_gl_color_bits(framebuffer, bits, &encoding);
+    red = bits[0];
+    green = bits[1];
+    blue = bits[2];
+#else
     glGetIntegerv(GL_RED_BITS, &red);
     glGetIntegerv(GL_GREEN_BITS, &green);
     glGetIntegerv(GL_BLUE_BITS, &blue);
-    glGetIntegerv(GL_SAMPLES, &samples);
     glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER,
         framebuffer ? GL_COLOR_ATTACHMENT0 : GL_BACK,
         GL_FRAMEBUFFER_ATTACHMENT_COLOR_ENCODING, &encoding);
+#endif
+    glGetIntegerv(GL_SAMPLES, &samples);
     if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE ||
         red != 8 || green != 8 || blue != 8 || samples > 1 || encoding != GL_LINEAR)
         goto restore;
diff --git a/src/dvbridge_render.c b/src/dvbridge_render.c
index c76ae26..65af23f 100644
--- a/src/dvbridge_render.c
+++ b/src/dvbridge_render.c
@@ -4148,12 +4148,17 @@ static bool dv_final_framebuffer(unsigned framebuffer,unsigned alpha_bits)
     GLint draw,read,bits[4],encoding=0;
     glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING,&draw);glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING,&read);
     glBindFramebuffer(GL_FRAMEBUFFER,framebuffer);
-    const GLenum channels[4]={GL_RED_BITS,GL_GREEN_BITS,GL_BLUE_BITS,GL_ALPHA_BITS};
     bool valid=glCheckFramebufferStatus(GL_FRAMEBUFFER)==GL_FRAMEBUFFER_COMPLETE;
     if(valid){
+#if defined(DVBRIDGE_DESKTOP_GL)
+        dvbridge_gl_color_bits(framebuffer,bits,&encoding);
+        for(unsigned i=0;i<4;i++)valid=valid && bits[i]==(i==3?alpha_bits:8);
+#else
+        const GLenum channels[4]={GL_RED_BITS,GL_GREEN_BITS,GL_BLUE_BITS,GL_ALPHA_BITS};
         for(unsigned i=0;i<4;i++){glGetIntegerv(channels[i],&bits[i]);valid=valid && bits[i]==(i==3?alpha_bits:8);}
         glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER,framebuffer?GL_COLOR_ATTACHMENT0:GL_BACK,
             GL_FRAMEBUFFER_ATTACHMENT_COLOR_ENCODING,&encoding);
+#endif
         valid=valid && encoding==GL_LINEAR;
     }
     glBindFramebuffer(GL_DRAW_FRAMEBUFFER,draw);glBindFramebuffer(GL_READ_FRAMEBUFFER,read);
