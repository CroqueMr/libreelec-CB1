+#endif
     pl_fmt format = pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 32, 32,
         PL_FMT_CAP_SAMPLEABLE|PL_FMT_CAP_RENDERABLE|PL_FMT_CAP_HOST_READABLE);
     if (!format) return NULL;
