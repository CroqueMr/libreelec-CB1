diff --git a/src/dvbridge_gl_api.h b/src/dvbridge_gl_api.h
index 649ebcc..377c3f9 100644
--- a/src/dvbridge_gl_api.h
+++ b/src/dvbridge_gl_api.h
@@ -7,6 +7,7 @@
 #endif
 #include <GL/gl.h>
 #include <GL/glext.h>
+#include <libplacebo/opengl.h>
 
 #ifndef GL_MAP_PERSISTENT_BIT_EXT
 #define GL_MAP_PERSISTENT_BIT_EXT GL_MAP_PERSISTENT_BIT
@@ -19,6 +20,16 @@
 #endif
 typedef PFNGLBUFFERSTORAGEPROC PFNGLBUFFERSTORAGEEXTPROC;
 
+/* Desktop GL compiles GLSL ES 3.x through GL_ARB_ES3_compatibility (300 es),
+ * GL_ARB_ES3_1_compatibility (310 es) and GL_ARB_ES3_2_compatibility (320 es). */
+static inline bool dvbridge_gl_glsl_es(pl_opengl gl, int version)
+{
+    if (version >= 310 && (gl->major < 4 || (gl->major == 4 && gl->minor < 3)))
+        return false;
+    return pl_opengl_has_ext(gl, version >= 320 ? "GL_ARB_ES3_2_compatibility" :
+        version >= 310 ? "GL_ARB_ES3_1_compatibility" : "GL_ARB_ES3_compatibility");
+}
+
 /* Core profiles dropped GL_RED_BITS and friends and call the default colour buffer
  * GL_BACK_LEFT, so read the sizes and the encoding from the bound colour attachment. */
 static inline void dvbridge_gl_color_bits(GLuint framebuffer, GLint bits[4], GLint *encoding)
diff --git a/src/dvbridge_render.c b/src/dvbridge_render.c
index d7ecf4c..640af87 100644
--- a/src/dvbridge_render.c
+++ b/src/dvbridge_render.c
@@ -3106,10 +3106,15 @@ bool dvbridge_retirement_owner_destroy(struct dvbridge_retirement_owner **owner)
 static bool dv_gpu_requirements(pl_gpu gpu)
 {
     pl_opengl gl=pl_opengl_get(gpu);
+#if defined(DVBRIDGE_DESKTOP_GL)
+    if(!gl || gl->major<3 || (gl->major==3 && gl->minor<2) ||
+       !pl_opengl_has_ext(gl,"GL_ARB_buffer_storage"))return false;
+#else
     const char *version=(const char *)glGetString(GL_VERSION);
     if(!gl || !version || strncmp(version,"OpenGL ES ",10) ||
        gl->major<3 || (gl->major==3 && gl->minor<1) ||
        !pl_opengl_has_ext(gl,"GL_EXT_buffer_storage"))return false;
+#endif
     GLint precision,range[2],size,groups,invocations,bindings;GLint64 storage;
     for(unsigned i=0;i<2;i++){
         glGetShaderPrecisionFormat(i?GL_FRAGMENT_SHADER:GL_VERTEX_SHADER,GL_HIGH_FLOAT,range,&precision);
@@ -3129,8 +3134,12 @@ static bool dv_gpu_requirements(pl_gpu gpu)
 static bool dv_transport_requirements(pl_gpu gpu)
 {
     pl_opengl gl=pl_opengl_get(gpu);
+#if defined(DVBRIDGE_DESKTOP_GL)
+    if(!gl || gl->major<3 || (gl->major==3 && gl->minor<2))return false;
+#else
     const char *version=(const char *)glGetString(GL_VERSION);
     if(!gl || !version || strncmp(version,"OpenGL ES ",10) || gl->major<3)return false;
+#endif
     GLint precision,range[2];
     glGetShaderPrecisionFormat(GL_FRAGMENT_SHADER,GL_HIGH_FLOAT,range,&precision);
     return precision>=23 && range[0]>=127 && range[1]>=127 && glGetError()==GL_NO_ERROR &&
@@ -3158,7 +3167,11 @@ bool dvbridge_renderer_supports_mode(struct dvbridge_renderer *r,enum dvbridge_m
 static bool hdr10_ai_gpu_requirements(pl_gpu gpu)
 {
     pl_opengl gl=pl_opengl_get(gpu);
+#if defined(DVBRIDGE_DESKTOP_GL)
+    if(!gl || !dvbridge_gl_glsl_es(gl,310))return false;
+#else
     if(!gl || !gpu->glsl.gles || gl->major<3 || (gl->major==3 && gl->minor<1))return false;
+#endif
     if(!pl_find_fmt(gpu,PL_FMT_UNORM,4,16,16,PL_FMT_CAP_SAMPLEABLE|PL_FMT_CAP_RENDERABLE) ||
        !pl_find_fmt(gpu,PL_FMT_FLOAT,4,32,32,PL_FMT_CAP_SAMPLEABLE|PL_FMT_CAP_RENDERABLE|PL_FMT_CAP_HOST_READABLE) ||
        !pl_find_fmt(gpu,PL_FMT_FLOAT,1,32,32,PL_FMT_CAP_SAMPLEABLE))return false;
