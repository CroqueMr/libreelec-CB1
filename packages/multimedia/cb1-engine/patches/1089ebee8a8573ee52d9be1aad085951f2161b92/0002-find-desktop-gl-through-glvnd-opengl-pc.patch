From bdd8ad0e7c14592c20f7f0518f479e7afd3d0dbc Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Tue, 10 Nov 2026 03:21:48 +0000
Subject: [PATCH] CB1: find desktop GL through glvnd's opengl.pc too

LibreELEC's OpenGL device builds Mesa with glvnd, which provides
opengl.pc and no gl.pc.
---
 config/owned-sources.json | 2 +-
 src/CMakeLists.txt        | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/config/owned-sources.json b/config/owned-sources.json
index 02f3244..f4042b1 100644
--- a/config/owned-sources.json
+++ b/config/owned-sources.json
@@ -25,7 +25,7 @@
   "src/cb1_hdr10_temporal.h": "41908e5fd369a6906322bd98c2470e4abf34a138867d10624988ea3c2a8ae1e8",
   "src/cb1_l1l3_model.c": "b79de37755814ad9ae3b99a089a070cb3a2e0bee98cfa121ab787332887fd88b",
   "src/cb1_l1l3_model.h": "9d34cc7c145a91cabcf60cc57c41f6cf736686f79e09cb2019333f2c418af0ea",
-  "src/CMakeLists.txt": "33d9b09d01164716cd48271db471cb24792cffc12218b76cb14901b22574dce9",
+  "src/CMakeLists.txt": "3824a084efd792c0c6dc44dae4e94635118e14a05ff628434a1751db5f10212e",
   "src/dvbridge_core.c": "37d4d9f79ac1baec3b0f0ce632f844fcb01b3b13a40391b3e02a15a2108d4219",
   "src/dvbridge_core.h": "a20192013d7ae5d01b1ea596a79c306cfc3ad25e663e4e4052dc2339266af9e4",
   "src/dvbridge_creative.c": "ec9c450a4af41a45003564794916471df4f87ba5d711c2c8ac08fe8111c1283d",
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 9a1cde5..4de143d 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -46,7 +46,8 @@ pkg_check_modules(DVAvutil REQUIRED IMPORTED_TARGET libavutil>=59.12.100)
 pkg_check_modules(DVAvcodec REQUIRED IMPORTED_TARGET libavcodec>=62)
 # Kodi's render API decides which GL the bridge links: desktop OpenGL or OpenGL ES.
 if(TARGET ${APP_NAME_LC}::OpenGl)
-  pkg_check_modules(DVGles REQUIRED IMPORTED_TARGET gl)
+  # glvnd ships desktop GL as opengl.pc; Mesa without glvnd as gl.pc.
+  pkg_search_module(DVGles REQUIRED IMPORTED_TARGET gl opengl)
   set(DVBRIDGE_DESKTOP_GL ON)
 else()
   pkg_check_modules(DVGles REQUIRED IMPORTED_TARGET glesv2)
