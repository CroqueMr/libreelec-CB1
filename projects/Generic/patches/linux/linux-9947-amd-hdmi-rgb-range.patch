Subject: [PATCH] drm/amd/display: keep limited RGB for HDMI-VIC timings

Legacy 4K HDMI signals can carry the timing in a VSIF with AVI VIC zero.
Keep the HDMI signal check upstream and retain the HDMI-VIC case.

--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -751,7 +751,7 @@
 	default:
 		return dc_is_hdmi_signal(signal) &&
 		       connector_state->connector->display_info.is_hdmi &&
-		       dc_crtc_timing->vic > 1;
+		       (dc_crtc_timing->vic > 1 || dc_crtc_timing->hdmi_vic);
 	}
 }
 
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
@@ -622,6 +622,12 @@
 	state.colorspace = DRM_MODE_COLORIMETRY_DEFAULT;
 	state.hdmi.broadcast_rgb = DRM_HDMI_BROADCAST_RGB_AUTO;
 
+	KUNIT_EXPECT_EQ(test, (int)amdgpu_dm_get_output_color_space(&timing, &state,
+								    SIGNAL_TYPE_HDMI_TYPE_A),
+			(int)COLOR_SPACE_SRGB_LIMITED);
+
+	timing.vic = 0;
+	timing.hdmi_vic = 1;
 	KUNIT_EXPECT_EQ(test, (int)amdgpu_dm_get_output_color_space(&timing, &state,
 								    SIGNAL_TYPE_HDMI_TYPE_A),
 			(int)COLOR_SPACE_SRGB_LIMITED);
