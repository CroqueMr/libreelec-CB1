Subject: [PATCH] drm/amd/display: preserve stream-owned HDMI packets across flips

Prevent auto low-latency updates from replacing Dolby, HDR10+ or timing
metadata. Keep a mode-owned packet for ordinary HDMI when ALLM ends.
Submit a stream update when only the HDR10+ packet changes.

--- a/drivers/gpu/drm/amd/display/dc/dc_stream.h
+++ b/drivers/gpu/drm/amd/display/dc/dc_stream.h
@@ -218,6 +218,7 @@
 	struct dc_info_packet vrr_infopacket;
 	struct dc_info_packet vsc_infopacket;
 	struct dc_info_packet vsp_infopacket;
+	struct dc_info_packet cb1_mode_vsp_infopacket;
 	struct dc_info_packet hfvsif_infopacket;
 	struct dc_info_packet vtem_infopacket;
 	struct dc_info_packet adaptive_sync_infopacket;
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1801,6 +1801,7 @@
 		} else {
 			amdgpu_dm_build_hdmi_vsif(connector, &mode, &stream->vsp_infopacket);
 		}
+		stream->cb1_mode_vsp_infopacket = stream->vsp_infopacket;
 		stream->timing.timing_3d_format = saved_3d;
 		stream->view_format = saved_view;
 	}
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -4223,8 +4223,10 @@
 					continue;
 				if (!amdgpu_dm_fill_hdr10plus_info_packet(conn->hdr10plus_metadata, &bundle->hdr10plus) &&
 				    memcmp(&bundle->hdr10plus, &acrtc_state->stream->vsp_infopacket,
-					   sizeof(bundle->hdr10plus)))
+					   sizeof(bundle->hdr10plus))) {
 					bundle->stream_update.vsp_infopacket = &bundle->hdr10plus;
+					stream_update_needed = true;
+				}
 			}
 		}
 		if (new_pcrtc_state->mode_changed) {
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_freesync.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_freesync.c
@@ -190,6 +190,18 @@
 	return hdr->sb[DP_HDR_SDP_EOTF_IDX] == HDMI_EOTF_SMPTE_ST2084;
 }
 
+static bool amdgpu_dm_hdmi_content_owns_vsif(const struct dc_stream_state *stream,
+					     const struct dm_crtc_state *crtc)
+{
+	const struct dc_info_packet *packet = &stream->vsp_infopacket;
+	u32 oui = packet->sb[1] | (packet->sb[2] << 8) | (packet->sb[3] << 16);
+
+	return stream->dv_standard || stream->timing.hdmi_vic ||
+	       (crtc->base.mode.flags & DRM_MODE_FLAG_3D_MASK) ||
+	       (packet->valid && packet->hb0 == HDMI_INFOFRAME_TYPE_VENDOR &&
+		oui == HDMI_HDR10PLUS_IEEE_OUI);
+}
+
 void amdgpu_dm_update_freesync_state_on_stream(
 	struct amdgpu_display_manager *dm,
 	struct dm_crtc_state *new_crtc_state,
@@ -269,20 +281,16 @@
 		 TRANSFER_FUNC_PQ2084 :
 		 TRANSFER_FUNC_UNKNOWN;
 
-	mod_freesync_build_vrr_infopacket(
-		dm->freesync_module,
-		new_stream,
-		&vrr_params,
-		packet_type,
-		app_tf,
-		&vrr_infopacket,
-		pack_sdp_v1_3);
+	if (!new_stream->dv_standard)
+		mod_freesync_build_vrr_infopacket(dm->freesync_module, new_stream,
+						&vrr_params, packet_type, app_tf,
+						&vrr_infopacket, pack_sdp_v1_3);
 
 	/*
 	 * If the sink does not support FreeSync, but it does support VRR,
 	 * we need to build a VTEM packet to enable VRR.
 	 */
-	if (aconn && !aconn->vsdb_info.freesync_supported &&
+	if (!new_stream->dv_standard && aconn && !aconn->vsdb_info.freesync_supported &&
 	    aconn->base.display_info.hdmi.vrr_cap.supported &&
 	    (new_stream->signal == SIGNAL_TYPE_HDMI_FRL ||
 	     new_stream->signal == SIGNAL_TYPE_HDMI_TYPE_A)) {
@@ -306,15 +314,16 @@
 
 	new_stream->vrr_infopacket = vrr_infopacket;
 	new_stream->vtem_infopacket = vtem_infopacket;
-	new_stream->allow_freesync = mod_freesync_get_freesync_enabled(&vrr_params);
+	new_stream->allow_freesync = !new_stream->dv_standard &&
+		mod_freesync_get_freesync_enabled(&vrr_params);
 
 	/*
 	 * HDMI ALLM: when Gaming-VRR is active (VRR_EN=1) and the sink
 	 * advertises ALLM in the SCDS, the Source shall transmit the HF-VSIF
 	 * with ALLM_Mode=1 (HDMI 2.1 Section 7.6.6).
 	 */
-	if (new_stream->signal == SIGNAL_TYPE_HDMI_TYPE_A ||
-	    new_stream->signal == SIGNAL_TYPE_HDMI_FRL) {
+	if (dc_is_hdmi_signal(new_stream->signal) &&
+	    !amdgpu_dm_hdmi_content_owns_vsif(new_stream, new_crtc_state)) {
 		struct dc_info_packet vsp_infopacket = {0};
 		bool sink_allm = aconn && aconn->base.display_info.hdmi.allm;
 		bool allm = sink_allm &&
@@ -322,7 +331,10 @@
 			 vrr_params.state == VRR_STATE_ACTIVE_FIXED);
 		bool allm_changed;
 
-		mod_build_hf_vsif_infopacket(new_stream, &vsp_infopacket, allm, allm);
+		if (allm)
+			mod_build_hf_vsif_infopacket(new_stream, &vsp_infopacket, true, true);
+		else
+			vsp_infopacket = new_stream->cb1_mode_vsp_infopacket;
 
 		allm_changed = memcmp(&new_stream->vsp_infopacket, &vsp_infopacket,
 				      sizeof(vsp_infopacket)) != 0;
